  </ImportGroup>
  <ImportGroup Condition=" '$(TargetFramework)' == 'net8.0' AND '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)microsoft.testing.platform/1.8.2/buildTransitive/net8.0/Microsoft.Testing.Platform.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.testing.platform/1.8.2/buildTransitive/net8.0/Microsoft.Testing.Platform.targets')" />
